# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CASHIFY_CLIENT_KEY: Client API Key for Cashify price estimate and old device valuation API.
CASHIFY_CLIENT_KEY="MY_CASHIFY_CLIENT_KEY"

# CASHFREE PAYMENT GATEWAY CREDENTIALS:
CASHFREE_APP_ID="MY_CASHFREE_APP_ID"
CASHFREE_SECRET_KEY="MY_CASHFREE_SECRET_KEY"
